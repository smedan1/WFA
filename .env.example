# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional: Reddit data (Xpoz) ──────────────────────────────────────────────

# Bearer token from https://xpoz.ai — enables live r/wallstreetbets data.
# Without this, the app falls back to the most recent GitHub history snapshot.
XPOZ_TOKEN=your_xpoz_bearer_token

# ── Optional: GitHub persistence ─────────────────────────────────────────────

# Personal Access Token with repo write access — enables saving recommendation
# snapshots, stock analysis cache, and ADSK Easter egg result to GitHub.
# Without this, no data is persisted across server restarts.
# Get from https://github.com/settings/tokens (classic, repo scope)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=WFA

# ── Optional: Server config ───────────────────────────────────────────────────

# Comma-separated allowed CORS origins. Defaults to http://localhost:5173.
# In production (Railway), set to the client service public URL.
CORS_ORIGIN=https://wfaclient-production.up.railway.app

# Server port (defaults to 3001)
PORT=3001
